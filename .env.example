PORT=3000
NODE_ENV=development

# MariaDB
dbLocal=127.0.0.1
dbUsername=root
dbPassword=
dbName=game_achievements
DB_POOL_SIZE=10

# Auth (required in production — 32+ characters each)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
TOKEN_ENCRYPTION_KEY=change-me-32-char-minimum-secret

# Optional: comma-separated origins for CORS (e.g. http://localhost:5173)
CORS_ORIGIN=

# RetroAchievements (app-level API key for sync)
retroAPIKey=
retroUsername=

# PlayStation (optional defaults for linking)
npsso=
psnAccountID=me

# Steam
STEAM_API_KEY=
steamID=
steamUsername=

# Xbox (prefer OAuth tokens via link body; avoid storing passwords)
xboxUID=
