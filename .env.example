PORT=3000

# MariaDB
dbLocal=127.0.0.1
dbUsername=root
dbPassword=
dbName=game_achievements

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
TOKEN_ENCRYPTION_KEY=change-me-32-char-minimum-secret

# RetroAchievements (app-level API key for sync)
retroAPIKey=
retroUsername=

# PlayStation (optional defaults for linking)
npsso=
psnAccountID=me

# Steam
STEAM_API_KEY=
steamID=
steamUsername=

# Xbox (prefer OAuth tokens via link body; avoid storing passwords)
xboxUID=
